# Pixel Race — example environment configuration.
# Copy this file to `.env` and adjust values for your local setup.
# NEVER commit a real `.env` file — it is gitignored.

# --- API (apps/api) ---
# Port the Fastify API listens on.
PORT=3001
# Host interface the API binds to.
HOST=0.0.0.0
# Runtime environment: development | test | production
NODE_ENV=development

# --- Auth / JWT ---
# Secret used to sign and verify JWT access tokens.
# REQUIRED in production (the API refuses to boot without it). In development a
# clearly-insecure fallback is used if this is empty — do NOT use that in prod.
# Generate a strong value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Short-lived access-token lifetime. No refresh token is issued in the POC.
JWT_EXPIRES_IN=15m

# --- CORS ---
# Comma-separated list of allowed browser origins for the API.
# The web dev server runs on http://localhost:5173 by default.
CORS_ORIGINS=http://localhost:5173

# --- Web (apps/web) ---
# Buy Me a Coffee page opened by the floating donate button (bottom-right).
# Vite reads VITE_* vars from apps/web/.env. If unset, a placeholder URL is used.
# VITE_BUY_ME_A_COFFEE_URL=https://buymeacoffee.com/your-username
# Turn accounts on/off. "false" makes the site guest-only: the Login/Register
# buttons are hidden and /login, /register, /leaderboard and /profile redirect
# to /play. On when unset. Build-time value: restart Vite / rebuild after changing.
# Only the web app is gated; the API's /api/v1/auth routes stay available.
# VITE_AUTH_ENABLED=true
# Public site URL for SEO (canonical, og:url, og:image, sitemap.xml). On Vercel
# leave it unset: the build uses VERCEL_PROJECT_PRODUCTION_URL automatically.
# Set it once the site has its own domain. Build-time value.
# VITE_SITE_URL=https://your-domain.example

# --- Database (SQLite) ---
# Filesystem path to the SQLite database file, used by the API at runtime and
# by the db:migrate / db:seed scripts.
# Resolution (consistent across the API and the db scripts):
#   - A RELATIVE path resolves against the repo root, NOT the current working
#     directory — so it points at the same file no matter where you launch from.
#   - An ABSOLUTE path is used as-is. ":memory:" is an ephemeral in-memory DB.
# The API fails loudly if the file is missing or unmigrated (run `npm run
# db:migrate` first); it never silently creates an empty database.
# Leaving this unset uses <repo>/database/pixel-race.sqlite (the default).
# Keep this OUTSIDE any publicly served static assets in production.
# DATABASE_PATH=database/pixel-race.sqlite
